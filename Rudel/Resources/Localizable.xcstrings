    "Ohne Angabe steht in der Liste „%@“.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden navn vises »%@« på listen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If left empty, the list shows “%@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo dejas vacío, la lista muestra «%@»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman nimeä luettelossa näkyy ”%@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans indication, la liste affiche « %@ »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lasci vuoto, l'elenco mostra «%@»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空欄の場合、リストには「%@」と表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비워 두면 목록에 ‘%@’(으)로 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten navn vises «%@» i listen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder invoer staat er in de lijst ‘%@’."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ficar vazio, a lista mostra “%@”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan namn visas ”%@” i listan."
          }
        }
      }
    },
