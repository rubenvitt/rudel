    "Zusätzlich kommt am Vortag eine Mitteilung zur Erinnerungszeit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll also get a notification the day before at the reminder time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daarnaast krijg je de dag ervoor een melding op het herinneringstijdstip."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous recevez aussi une notification la veille, à l'heure des rappels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Además, recibirás una notificación el día anterior a la hora de los recordatorios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inoltre ricevi una notifica il giorno prima all'orario dei promemoria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Além disso, você recebe uma notificação na véspera, no horário dos lembretes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessutom kommer en notis dagen före vid påminnelsetiden."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I tillegg kommer et varsel dagen før på påminnelsestidspunktet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derudover kommer der en notifikation dagen før på påmindelsestidspunktet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisäksi saat ilmoituksen edellisenä päivänä muistutusten kellonaikaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さらに前日のリマインダー時刻にも通知が届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전날 리마인더 시간에도 알림이 와요."
          }
        }
      }
    },
    "Zyklen besser kennenlernen": {
