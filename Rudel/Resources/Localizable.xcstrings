    "Vorbereitung. Blutiger Ausfluss, pralle Vulva, Rüden interessieren sich — sie duldet aber noch nicht.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Forberedelse. Blodigt udflåd, fast og hævet vulva, hanner viser interesse — men hun står endnu ikke for parring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparation. Bloody discharge, firm swollen vulva, male dogs show interest — but she won't accept mating yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparación. Flujo sanguinolento, vulva hinchada y firme, los machos muestran interés, pero aún no acepta la monta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valmistautuminen. Verinen vuoto, turvonnut ja kiinteä ulkosynnytin, urokset kiinnostuvat — mutta narttu ei vielä hyväksy astutusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation. Pertes sanglantes, vulve gonflée et ferme, les mâles s'y intéressent — mais elle n'accepte pas encore la saillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparazione. Perdite ematiche, vulva gonfia e turgida, i maschi si interessano — ma lei non accetta ancora l'accoppiamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備期。血の混じったおりもの、張りのある外陰部の腫れ。オス犬が興味を示しますが、まだ交配は受け入れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비 단계예요. 피가 섞인 분비물, 단단하게 부은 외음부, 수컷이 관심을 보이지만 아직 교배를 허용하지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Forberedelse. Blodig utflod, stram og hoven vulva, hannhunder blir interessert — men hun står ikke for parring ennå."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbereiding. Bloederige afscheiding, stevige gezwollen vulva, reuen tonen interesse — maar ze laat zich nog niet dekken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparação. Corrimento com sangue, vulva inchada e firme, os machos se interessam — mas ela ainda não aceita a cruza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förberedelse. Blodiga flytningar, svullen och fast vulva, hanar visar intresse — men hon står inte för parning än."
          }
        }
      }
    },
