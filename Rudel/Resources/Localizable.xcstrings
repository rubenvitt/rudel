    "Der Balken in der Liste zeigt, wie lange der Schutz noch hält.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bjælken i listen viser, hvor længe beskyttelsen holder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bar in the list shows how long the protection lasts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de la lista muestra cuánto dura aún la protección."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luettelon palkki näyttää, kuinka kauan suoja vielä kestää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre dans la liste indique combien de temps la protection dure encore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra nell'elenco mostra quanto dura ancora la protezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストのバーで、保護があとどれくらい続くかがわかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록의 막대에서 보호가 얼마나 남았는지 볼 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Linjen i listen viser hvor lenge beskyttelsen varer."
          }
        },
