    "Beobachtungen kommen dazu, nichts wird überschrieben.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Observationer tilføjes, intet overskrives."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Observations are added – nothing is overwritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las observaciones se añaden; nada se sobrescribe."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Havainnot lisätään, mitään ei korvata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les observations s'ajoutent, rien n'est écrasé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le osservazioni si aggiungono, nulla viene sovrascritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観察は追加され、上書きされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관찰은 추가될 뿐 덮어쓰지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Observasjoner legges til, ingenting overskrives."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarnemingen worden toegevoegd, niets wordt overschreven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As observações são adicionadas; nada é sobrescrito."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Observationer läggs till, inget skrivs över."
          }
        }
      }
    },
