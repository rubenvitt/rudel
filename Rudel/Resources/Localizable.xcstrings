    "iOS lässt gerade keine weiteren Alarme zu. Für %lld Gaben erinnert Rudel stattdessen mit einer Mitteilung.": {
      "comment": "AlarmKit limit reached; %lld = doses that fall back to notifications",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS lässt gerade keine weiteren Alarme zu. Für eine Gabe erinnert Rudel stattdessen mit einer Mitteilung."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS lässt gerade keine weiteren Alarme zu. Für %lld Gaben erinnert Rudel stattdessen mit einer Mitteilung."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS isn't allowing any more alarms right now. Rudel will remind you of one dose with a notification instead."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS isn't allowing any more alarms right now. Rudel will remind you of %lld doses with notifications instead."
                }
              }
            }
          }
        },
        "nl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS staat nu geen extra alarmen toe. Voor één toediening herinnert Rudel je in plaats daarvan met een melding."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS staat nu geen extra alarmen toe. Voor %lld toedieningen herinnert Rudel je in plaats daarvan met meldingen."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS n'accepte plus d'alarmes pour le moment. Pour une prise, Rudel vous enverra plutôt une notification."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS n'accepte plus d'alarmes pour le moment. Pour %lld prises, Rudel vous enverra plutôt des notifications."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS n'accepte plus d'alarmes pour le moment. Pour %lld prises, Rudel vous enverra plutôt des notifications."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS no permite más alarmas ahora mismo. Para una toma, Rudel te avisará con una notificación."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS no permite más alarmas ahora mismo. Para %lld tomas, Rudel te avisará con notificaciones."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS no permite más alarmas ahora mismo. Para %lld tomas, Rudel te avisará con notificaciones."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "iOS al momento non consente altre sveglie. Per una somministrazione Rudel ti avviserà con una notifica."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
