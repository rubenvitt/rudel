    "Die Art lässt sich nicht mehr ändern, weil zu diesem Plan schon Einträge dokumentiert sind.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen kan ikke længere ændres, fordi der allerede er registreret poster for denne plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The type can no longer be changed because entries have already been recorded for this plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo ya no se puede cambiar porque este plan ya tiene registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tyyppiä ei voi enää muuttaa, koska suunnitelmaan on jo kirjattu merkintöjä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type ne peut plus être modifié, car des entrées ont déjà été enregistrées pour ce plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tipo non può più essere modificato perché per questo piano sono già state registrate voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプランには記録があるため、種類は変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획에 이미 기록이 있어 종류를 변경할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen kan ikke lenger endres fordi det allerede er registrert oppføringer for denne planen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De soort kan niet meer worden gewijzigd, omdat er al items voor dit plan zijn vastgelegd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tipo não pode mais ser alterado porque já há registros neste plano."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Typen kan inte längre ändras eftersom poster redan har registrerats för planen."
          }
        }
      }
    },
