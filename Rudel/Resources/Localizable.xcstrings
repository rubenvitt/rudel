          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den første verdien. Fra den andre viser Rudel utviklingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De eerste waarde. Vanaf de tweede toont Rudel het verloop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O primeiro valor. A partir do segundo, o Rudel mostra a evolução."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det första värdet. Från det andra visar Rudel förloppet."
          }
        }
      }
    },
    "Der untere Wert muss kleiner sein als der obere.": {
      "localizations": {
