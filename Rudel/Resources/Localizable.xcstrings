    "Daraus ergibt sich die Restwirksamkeit: %@ ab der letzten Gabe.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det giver den resterende virkning: %@ fra sidste dosis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This determines the remaining protection: %@ from the last dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De ahí sale la protección restante: %@ desde la última toma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä saadaan jäljellä oleva suoja: %@ viimeisestä annoksesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La protection restante en découle : %@ à partir de la dernière prise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qui deriva la protezione residua: %@ dall'ultima somministrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから残りの効果期間を計算します：前回の投与から%@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 기준으로 남은 효과를 계산해요: 마지막 투여부터 %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gir gjenværende virkning: %@ fra siste dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daaruit volgt de resterende werking: %@ vanaf de laatste toediening."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disso resulta a proteção restante: %@ a partir da última dose."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ger den återstående effekten: %@ från senaste dosen."
          }
        }
      }
    },
    "Das Ende der sichtbaren Hitze ist nicht das Ende des Zyklus — der Diöstrus läuft danach noch 60–90 Tage.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutningen på den synlige løbetid er ikke slutningen på cyklussen – diøstrus varer derefter 60–90 dage endnu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The end of visible heat isn't the end of the cycle – diestrus continues for another 60–90 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El final del celo visible no es el final del ciclo: el diestro dura todavía 60–90 días."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näkyvän kiiman loppu ei ole kierron loppu – diestrus jatkuu vielä 60–90 päivää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fin des chaleurs visibles n'est pas la fin du cycle : le dioestrus dure encore 60 à 90 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fine del calore visibile non è la fine del ciclo: il diestro dura ancora 60–90 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見た目のヒートが終わっても周期は終わりません。その後も発情休止期が60～90日続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에 보이는 발정이 끝나도 주기가 끝난 것은 아니에요. 그 뒤로 발정후기가 60~90일 더 이어져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutten på synlig løpetid er ikke slutten på syklusen – diøstrus varer deretter i 60–90 dager til."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het einde van de zichtbare loopsheid is niet het einde van de cyclus – de dioestrus duurt daarna nog 60–90 dagen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fim do cio visível não é o fim do ciclo: o diestro ainda dura 60–90 dias."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutet på det synliga löpet är inte slutet på cykeln – diöstrus pågår sedan i ytterligare 60–90 dagar."
          }
        }
      }
    },
