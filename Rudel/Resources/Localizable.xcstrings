    "Sie verschiebt den Startwert der Zyklusprognose nicht.": {
      "comment": "„Sie“ = die Größenklasse",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It doesn't shift the starting value of the cycle forecast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze verschuift de startwaarde van de cyclusprognose niet."
          }
        },
        "fr": {
