    "Tierarzttermine, Praxen und die Notfallkarte findest du im Tab Tierarzt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyrlægetider, klinikker og nødkortet finder du på fanen Dyrlæge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find vet appointments, practices and the emergency card in the Vet tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrarás las citas, las clínicas y la tarjeta de emergencia en la pestaña Veterinario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Eläinlääkäriajat, vastaanotot ja hätäkortin löydät Eläinlääkäri-välilehdeltä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous trouverez les rendez-vous, les cabinets et la carte d'urgence dans l'onglet Vétérinaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovi gli appuntamenti, gli ambulatori e la scheda di emergenza nella scheda Veterinario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動物病院の予約、病院、緊急カードは「動物病院」タブにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동물병원 예약, 병원, 응급 카드는 동물병원 탭에서 볼 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Veterinærtimer, klinikker og nødkortet finner du i fanen Veterinær."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dierenartsafspraken, praktijken en de noodkaart vind je in het tabblad Dierenarts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você encontra as consultas, as clínicas e o cartão de emergência na aba Veterinário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Veterinärbesök, kliniker och nödkortet hittar du på fliken Veterinär."
          }
        }
      }
    },
