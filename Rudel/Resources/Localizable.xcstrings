    "Notfallpraxen stehen im Profil jedes Tiers unter „Notfall“.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Akutklinikker vises i hvert dyrs profil under »Nødsituation«."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency practices appear in every pet's profile under “Emergency”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las clínicas de urgencias aparecen en el perfil de cada mascota en «Emergencia»."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivystävät klinikat näkyvät jokaisen lemmikin profiilissa kohdassa ”Hätätilanne”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cabinets d'urgence figurent dans le profil de chaque animal sous « Urgence »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ambulatori d'urgenza compaiono nel profilo di ogni animale sotto «Emergenza»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "救急病院は各ペットのプロフィールの「緊急時」に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응급 병원은 각 반려동물 프로필의 ‘응급’에 표시돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Akuttklinikker vises i hvert dyrs profil under «Nødstilfelle»."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spoedpraktijken staan in het profiel van elk dier onder ‘Noodgeval’."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As clínicas de emergência aparecem no perfil de cada pet em “Emergência”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Akutkliniker visas i varje djurs profil under ”Nödfall”."
          }
        }
      }
    },
