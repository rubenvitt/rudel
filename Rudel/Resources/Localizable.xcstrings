    "iOS blockiert die Erinnerungen. Rudel kann erst wieder welche setzen, wenn du sie dort erlaubst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS is blocking reminders. Rudel can only schedule them again once you allow them there."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blokkeert de herinneringen. Rudel kan pas weer herinneringen instellen als je ze daar toestaat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bloque les rappels. Rudel ne pourra en programmer de nouveau qu'une fois que vous les aurez autorisés dans iOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS está bloqueando los recordatorios. Rudel no podrá programarlos de nuevo hasta que los permitas allí."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blocca i promemoria. Rudel potrà impostarli di nuovo solo quando li consentirai lì."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS está bloqueando os lembretes. O Rudel só poderá agendá-los de novo quando você permitir lá."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blockerar påminnelserna. Rudel kan inte schemalägga några förrän du tillåter dem där."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blokkerer påminnelsene. Rudel kan ikke planlegge nye før du tillater dem der."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS blokerer påmindelserne. Rudel kan først planlægge nye, når du tillader dem der."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS estää muistutukset. Rudel voi ajastaa niitä taas vasta, kun sallit ne siellä."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがリマインダーをブロックしています。iOSで許可すると、Rudelで再び設定できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 리마인더를 차단하고 있어요. iOS에서 허용해야 Rudel이 다시 설정할 수 있어요."
          }
        }
      }
    },
    "iOS hat diese Mitteilung nicht angenommen.": {
      "comment": "Reason shown in settings for a notification request iOS rejected",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn't accept this notification."
          }
