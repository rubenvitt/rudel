    "Verlass dich auf die Spanne, der einzelne Tag ist nur ihre Mitte.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stol på spændet – den enkelte dag er kun midten af det."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rely on the range – the single date is just its midpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fíate del rango: el día concreto es solo su punto medio."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luota vaihteluväliin – yksittäinen päivä on vain sen keskikohta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiez-vous à la fourchette : la date seule n'en est que le milieu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Affidati all'intervallo: il singolo giorno ne è solo il centro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期間の幅を目安にしてください。1日だけの日付は、その中央にすぎません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기간 전체를 참고하세요. 특정 날짜는 그 중간일 뿐이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stol på spennet – den enkelte dagen er bare midten av det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertrouw op de marge; de afzonderlijke dag is alleen het midden ervan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confie no intervalo: o dia exato é apenas o meio dele."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lita på spannet – den enskilda dagen är bara mitten av det."
          }
        }
      }
    },
