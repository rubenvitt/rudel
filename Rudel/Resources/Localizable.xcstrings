    "Wiege %@ und halte den ersten Wert fest. Mit dem zweiten Eintrag beginnt euer Gewichtsverlauf.": {
      "comment": "%@ = pet name or 'dein Tier'",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vej %@ og gem den første værdi. Med den anden registrering begynder jeres vægtkurve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigh %@ and record the first value. With the second entry, your weight history begins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesa a %@ y registra el primer valor. Con el segundo registro empieza el historial de peso."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Punnitse %@ ja tallenna ensimmäinen lukema. Toisesta merkinnästä alkaen näet painokäyrän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesez %@ et notez la première valeur. À partir de la deuxième entrée, la courbe de poids commence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesa %@ e registra il primo valore. Con la seconda registrazione inizia l'andamento del peso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の体重を量って、最初の値を記録しましょう。2回目の記録から体重の推移が始まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 체중을 재고 첫 번째 값을 기록하세요. 두 번째 기록부터 체중 추이가 시작돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vei %@ og lagre den første verdien. Med den andre registreringen starter vektkurven deres."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weeg %@ en leg de eerste waarde vast. Met de tweede invoer begint jullie gewichtsverloop."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pese %@ e registre o primeiro valor. A partir do segundo registro começa o histórico de peso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väg %@ och spara det första värdet. Med den andra posten börjar er viktkurva."
          }
        }
      }
    },
