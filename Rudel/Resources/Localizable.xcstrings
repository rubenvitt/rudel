    "Fasst Medikamente, Symptome, Gewicht und Termine als PDF für die Praxis zusammen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samler medicin, symptomer, vægt og tider i en PDF til klinikken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarizes medications, symptoms, weight and appointments as a PDF for the practice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume medicamentos, síntomas, peso y citas en un PDF para la clínica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koostaa lääkkeet, oireet, painon ja ajat PDF-tiedostoksi vastaanotolle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résume les médicaments, symptômes, poids et rendez-vous dans un PDF pour le cabinet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassume farmaci, sintomi, peso e appuntamenti in un PDF per l'ambulatorio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お薬、症状、体重、予約を病院向けのPDFにまとめます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약, 증상, 체중, 예약을 병원용 PDF로 정리해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Oppsummerer medisiner, symptomer, vekt og timer som PDF for klinikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vat medicijnen, symptomen, gewicht en afspraken samen in een pdf voor de praktijk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume medicamentos, sintomas, peso e consultas em um PDF para a clínica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanfattar läkemedel, symtom, vikt och besök som PDF för kliniken."
          }
        }
      }
    },
