    "Nachlauf, 60–90 Tage. Anzeichen klingen ab; Scheinträchtigkeit ist hier möglich.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Efterfase, 60–90 dage. Tegnene aftager; falsk drægtighed er mulig i denne fase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aftermath, 60–90 days. Signs fade; false pregnancy is possible during this phase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase posterior, 60–90 días. Los signos remiten; en esta fase es posible un embarazo psicológico."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jälkivaihe, 60–90 päivää. Merkit hiipuvat; valeraskaus on tässä vaiheessa mahdollinen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase de retour, 60 à 90 jours. Les signes s'estompent ; une pseudogestation est possible à ce stade."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase successiva, 60–90 giorni. I segni si attenuano; in questa fase è possibile una gravidanza isterica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後期、60〜90日。兆候は落ち着きます。この時期は偽妊娠が起こることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "후기, 60~90일이에요. 징후가 가라앉으며, 이 시기에는 상상임신이 생길 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Etterfase, 60–90 dager. Tegnene avtar; falsk drektighet er mulig i denne fasen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nafase, 60–90 dagen. Tekenen nemen af; schijnzwangerschap is in deze fase mogelijk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase posterior, 60–90 dias. Os sinais diminuem; nesta fase é possível uma pseudogestação."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Efterfas, 60–90 dagar. Tecknen avtar; skendräktighet är möjlig i den här fasen."
          }
        }
      }
    },
