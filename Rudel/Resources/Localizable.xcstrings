    "Von der Wurmkur bis zur täglichen Gabe: Lege den ersten Plan für %@ an. Rudel behält die Intervalle im Blick.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ormekur til daglig dosis: opret den første plan for %@. Rudel holder øje med intervallerne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From deworming to daily doses: create the first plan for %@. Rudel keeps track of the intervals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la desparasitación hasta la toma diaria: crea el primer plan para %@. Rudel vigila los intervalos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Madotuksesta päivittäiseen annokseen: luo lemmikin %@ ensimmäinen suunnitelma. Rudel pitää välit silmällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vermifuge à la prise quotidienne : créez le premier plan pour %@. Rudel surveille les intervalles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla sverminazione alla somministrazione quotidiana: crea il primo piano per %@. Rudel tiene d'occhio gli intervalli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "虫下しから毎日の投与まで。%@の最初のプランを作成しましょう。間隔はRudelが管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구충부터 매일 투여까지, %@의 첫 계획을 만들어 보세요. 간격은 Rudel이 챙겨요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ormekur til daglig dose: opprett den første planen for %@. Rudel holder oversikt over intervallene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van ontworming tot dagelijkse toediening: maak het eerste plan voor %@ aan. Rudel houdt de intervallen in de gaten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da vermifugação à dose diária: crie o primeiro plano para %@. O Rudel acompanha os intervalos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från avmaskning till daglig dos: lägg upp den första planen för %@. Rudel håller koll på intervallen."
          }
        }
      }
    },
    "Von der Wurmkur bis zur täglichen Gabe: Lege den ersten Plan für dein Tier an. Rudel behält die Intervalle im Blick.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ormekur til daglig dosis: opret den første plan for dit dyr. Rudel holder øje med intervallerne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From deworming to daily doses: create the first plan for your pet. Rudel keeps track of the intervals."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde la desparasitación hasta la toma diaria: crea el primer plan para tu mascota. Rudel vigila los intervalos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Madotuksesta päivittäiseen annokseen: luo lemmikillesi ensimmäinen suunnitelma. Rudel pitää välit silmällä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du vermifuge à la prise quotidienne : créez le premier plan pour votre animal. Rudel surveille les intervalles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalla sverminazione alla somministrazione quotidiana: crea il primo piano per il tuo animale. Rudel tiene d'occhio gli intervalli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "虫下しから毎日の投与まで。ペットの最初のプランを作成しましょう。間隔はRudelが管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구충부터 매일 투여까지, 반려동물의 첫 계획을 만들어 보세요. 간격은 Rudel이 챙겨요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fra ormekur til daglig dose: opprett den første planen for dyret ditt. Rudel holder oversikt over intervallene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van ontworming tot dagelijkse toediening: maak het eerste plan voor je dier aan. Rudel houdt de intervallen in de gaten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da vermifugação à dose diária: crie o primeiro plano para seu pet. O Rudel acompanha os intervalos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Från avmaskning till daglig dos: lägg upp den första planen för ditt djur. Rudel håller koll på intervallen."
          }
        }
      }
    },
