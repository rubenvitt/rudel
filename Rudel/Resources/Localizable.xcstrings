    "Welches Tier die anderen Tabs zeigen, wählst du dort oben links.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket dyr de andre faner viser, vælger du der øverst til venstre."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which pet the other tabs show at the top left of each tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué mascota muestran las demás pestañas arriba a la izquierda de cada una."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse muiden välilehtien vasemmasta yläkulmasta, mikä lemmikki niissä näkyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez l'animal affiché dans les autres onglets, en haut à gauche de chacun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli quale animale mostrano le altre schede in alto a sinistra in ciascuna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のタブに表示するペットは、各タブの左上で選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 탭에 표시할 반려동물은 각 탭의 왼쪽 위에서 선택해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvilket dyr de andre fanene viser, velger du der oppe til venstre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welk dier de andere tabbladen tonen, kies je daar linksboven."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha qual pet as outras abas mostram no canto superior esquerdo de cada uma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vilket djur de andra flikarna visar väljer du där uppe till vänster."
          }
        }
      }
    },
