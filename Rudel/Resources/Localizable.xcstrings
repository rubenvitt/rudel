    "Zum Korrigieren in der Liste nach links wischen und neu erfassen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stryg til venstre på listen, og registrer igen for at rette."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To correct, swipe left in the list and log it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corregir, desliza a la izquierda en la lista y vuelve a registrarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Korjaa pyyhkäisemällä luettelossa vasemmalle ja kirjaamalla uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour corriger, balayez vers la gauche dans la liste et enregistrez à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per correggere, scorri verso sinistra nell'elenco e registra di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正するには、リストで左にスワイプして記録し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정하려면 목록에서 왼쪽으로 쓸어 삭제한 뒤 다시 기록하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveip mot venstre i listen og registrer på nytt for å rette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om te corrigeren veeg je in de lijst naar links en leg je het opnieuw vast."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para corrigir, deslize para a esquerda na lista e registre novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svep åt vänster i listan och logga på nytt för att rätta."
          }
        }
      }
    },
