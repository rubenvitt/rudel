    "Mindestens eine Gabezeit ist nötig — ohne sie hätte das Medikament keine Fälligkeit.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der skal være mindst ét dosistidspunkt — ellers forfalder medicinen aldrig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one dose time is required — without it, the medication would never be due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se necesita al menos una hora de toma; sin ella, el medicamento no tendría fecha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vähintään yksi annosaika tarvitaan — muuten lääke ei koskaan erääntyisi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins une heure de prise est nécessaire — sans elle, le médicament n'aurait pas d'échéance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve almeno un orario: senza, il farmaco non avrebbe scadenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投与時刻が1つ以上必要です。ないと予定が作られません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투여 시간이 하나 이상 필요해요. 없으면 예정이 생기지 않아요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst én dosetid er nødvendig — ellers forfaller medisinen aldri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is minstens één toedieningstijd nodig — zonder kan het medicijn nooit gepland worden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso pelo menos um horário — sem ele, o medicamento não teria data prevista."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minst en dostid krävs — annars blir läkemedlet aldrig aktuellt."
          }
        }
      }
    },
    "Mit %@ werden %@ gelöscht. Das lässt sich nicht rückgängig machen.": {
      "comment": "Erstes %@ = Tiername, zweites %@ = Aufzählung, z. B. „3 Gaben und 1 Symptom“",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting %@ also deletes %@. This can't be undone."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met %@ worden ook %@ verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec %@, seront supprimés : %@. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto con %@ se eliminarán: %@. No se puede deshacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Insieme a %@ verranno eliminati: %@. L'operazione non può essere annullata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Junto com %@, serão apagados: %@. Não é possível desfazer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med %@ raderas även %@. Det går inte att ångra."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammen med %@ slettes %@. Dette kan ikke angres."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammen med %@ slettes %@. Det kan ikke fortrydes."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemmikin %@ mukana poistetaan %@. Tätä ei voi kumota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と一緒に%@が削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@와(과) 함께 %@이(가) 삭제돼요. 되돌릴 수 없어요."
          }
        }
      }
    },
