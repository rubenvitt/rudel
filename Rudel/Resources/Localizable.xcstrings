    "Fester Druck auf die Lenden — bleibt sie stehen und legt den Schwanz zur Seite, duldet sie.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk fast på lænden – bliver hun stående og lægger halen til side, står hun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press firmly on her lower back – if she stands still and moves her tail aside, she is standing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presiona con firmeza sobre la zona lumbar: si se queda quieta y aparta la cola, acepta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paina napakasti lantion seudulta – jos se pysyy paikallaan ja kääntää hännän sivuun, se seisoo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez fermement sur ses lombes : si elle s'immobilise et dévie la queue, elle accepte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi con decisione sui lombi: se resta ferma e sposta la coda di lato, accetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腰のあたりをしっかり押してみてください。じっと立ったまま尾を横によければ、許容しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허리 부분을 꾹 눌러 보세요. 가만히 서서 꼬리를 옆으로 젖히면 교배를 허용하는 상태예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk godt på korsryggen – blir hun stående og legger halen til side, står hun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk stevig op haar lendenen – blijft ze staan en legt ze haar staart opzij, dan is ze dekbereid."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione com firmeza a região lombar: se ela ficar parada e desviar a cauda, está aceitando."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck stadigt på ländryggen – står hon still och lägger svansen åt sidan, står hon."
          }
        }
      }
    },
