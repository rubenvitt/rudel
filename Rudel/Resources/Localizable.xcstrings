    "Automatisch aus dem letzten Gewichtseintrag abgeleitet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Derived automatically from the latest weight entry."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch afgeleid uit de laatste gewichtsmeting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déduit automatiquement de la dernière pesée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado automáticamente a partir del último registro de peso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricavata automaticamente dall'ultima pesata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calculado automaticamente a partir do último registro de peso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Härledd automatiskt från den senaste viktposten."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utledet automatisk fra siste vektregistrering."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udledt automatisk af den seneste vægtregistrering."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päätelty automaattisesti viimeisimmästä painomerkinnästä."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の体重記録から自動で判定しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 체중 기록에서 자동으로 정해졌어요."
          }
        }
      }
    },
    "Automatisch nimmt das letzte Gewicht, ohne Gewicht „Mittel“. Prägt vor allem die ersten Zyklusprognosen, mit jeder erfassten Läufigkeit weniger.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses the latest weight, or “Medium” without one. Mainly shapes the first cycle forecasts, less with every recorded heat cycle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch gebruikt het laatste gewicht, zonder gewicht “Middel”. Bepaalt vooral de eerste cyclusprognoses, met elke vastgelegde loopsheid minder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique utilise le dernier poids, ou « Moyen » sans pesée. Influe surtout sur les premières prévisions du cycle, de moins en moins à chaque période de chaleurs enregistrée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa el último peso o, sin peso, «Mediano». Influye sobre todo en las primeras previsiones del ciclo, y menos con cada celo registrado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatica usa l'ultimo peso, senza peso «Media». Influisce soprattutto sulle prime previsioni del ciclo, sempre meno a ogni calore registrato."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa o último peso; sem peso, “Médio”. Influencia principalmente as primeiras previsões do ciclo, e cada vez menos a cada cio registrado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatiskt använder den senaste vikten, utan vikt ”Mellan”. Påverkar främst de första cykelprognoserna, mindre för varje registrerat löp."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk bruker siste vekt, uten vekt «Middels». Påvirker særlig de første syklusprognosene, mindre for hver registrerte løpetid."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk bruger den seneste vægt, uden vægt »Mellem«. Påvirker især de første cyklusprognoser, mindre for hver registreret løbetid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen käyttää viimeisintä painoa, ilman painoa ”Keskikokoinen”. Vaikuttaa lähinnä ensimmäisiin kierron ennusteisiin, ja vähemmän jokaisen merkityn kiiman myötä."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」では最新の体重を使い、体重がなければ「中型」になります。主に最初の周期予測に影響し、ヒートを記録するたびに影響は小さくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'자동'은 최근 체중을 사용하고, 체중이 없으면 '중형'을 사용해요. 주로 처음 몇 번의 주기 예측에 영향을 주며, 발정을 기록할수록 영향이 줄어요."
          }
        }
      }
    },
