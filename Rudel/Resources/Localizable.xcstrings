            "value": "Sous la plage cible %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto l'intervallo obiettivo %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標範囲 %@ を下回っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표 범위 %@ 미만"
          }
