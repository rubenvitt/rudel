          }
        }
      }
    },
    "Ohne Enddatum läuft das Medikament unbefristet.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden slutdato fortsætter medicinen på ubestemt tid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without an end date, the medication continues indefinitely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fecha de fin, el medicamento sigue indefinidamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman päättymispäivää lääkitys jatkuu toistaiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans date de fin, le traitement continue indéfiniment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza data di fine il farmaco continua a tempo indeterminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了日がない場合、期限なく続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료일이 없으면 기한 없이 계속돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten sluttdato fortsetter medisinen på ubestemt tid."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder einddatum loopt het medicijn onbeperkt door."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem data de término, o medicamento continua por tempo indeterminado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan slutdatum pågår läkemedlet tills vidare."
          }
        }
      }
    },
    "Ohne Erinnerungen führt Rudel weiterhin jeden Eintrag — es meldet sich nur nicht von selbst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without reminders, Rudel still keeps every entry — it just won't notify you on its own."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder herinneringen houdt Rudel nog steeds alles bij — het meldt zich alleen niet uit zichzelf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans rappels, Rudel conserve toujours chaque entrée — il ne vous prévient simplement plus de lui-même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin recordatorios, Rudel sigue guardando cada registro; solo deja de avisarte por su cuenta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza promemoria, Rudel continua a registrare tutto: semplicemente non ti avvisa più da solo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem lembretes, o Rudel continua registrando tudo — só não avisa você por conta própria."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan påminnelser sparar Rudel fortfarande varje post – den hör bara inte av sig själv."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten påminnelser fører Rudel fortsatt alle registreringer – den sier bare ikke fra av seg selv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden påmindelser registrerer Rudel stadig alt – den giver bare ikke selv besked."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman muistutuksia Rudel tallentaa edelleen jokaisen merkinnän – se ei vain ilmoita itsestään."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーがオフでも、Rudelはすべての記録を保持します。自動で通知しないだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리마인더가 꺼져 있어도 Rudel은 모든 기록을 계속 남겨요. 스스로 알려 주지 않을 뿐이에요."
          }
        }
      }
    },
    "Ohne Gewichtseintrag greift Rudel auf „Mittel“ zurück.": {
      "comment": "„Mittel“ ist die mittlere Größenklasse",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a weight entry, Rudel uses “Medium”."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder gewichtsmeting gebruikt Rudel “Middel”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans pesée, Rudel utilise « Moyen »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin registro de peso, Rudel usa «Mediano»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza una pesata, Rudel usa «Media»."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem registro de peso, o Rudel usa “Médio”."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan viktpost utgår Rudel från ”Mellan”."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten vektregistrering bruker Rudel «Middels»."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden vægtregistrering bruger Rudel »Mellem«."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman painomerkintää Rudel käyttää luokkaa ”Keskikokoinen”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重の記録がない場合、Rudelは「中型」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 기록이 없으면 Rudel은 '중형'을 사용해요."
          }
        }
      }
    },
    "Ohne Rüden prüfbar: Flagging beim Streichen über die Kruppe, Duldung bei festem Druck auf die Lenden.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan tjekkes uden han: flagning når du stryger over krydset, står ved fast tryk på lænden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check without a male dog: flagging when you stroke her croup, standing when you press firmly on her lower back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede comprobar sin macho: desvía la cola al acariciarle la grupa y acepta al presionar con firmeza la zona lumbar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit tarkistaa ilman urosta: hännän kääntäminen, kun silität lantiota, seisominen, kun painat napakasti lannetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiable sans mâle : déviation de la queue quand on caresse la croupe, acceptation lors d'une pression ferme sur les lombes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificabile senza maschio: deviazione della coda accarezzando la groppa, accettazione con una pressione decisa sui lombi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オス犬がいなくても確認できます。お尻のあたりをなでると尾をよけるか、腰をしっかり押すとじっと立つかを見ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수컷 없이도 확인할 수 있어요. 엉덩이 위쪽을 쓰다듬을 때 꼬리를 젖히는지, 허리를 꾹 누를 때 가만히 서 있는지 보세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan sjekkes uten hannhund: flagging når du stryker over krysset, står ved godt trykk på korsryggen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te controleren zonder reu: staart opzij bij strijken over de kruis, dekbereidheid bij stevige druk op de lendenen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dá para verificar sem macho: desvio da cauda ao acariciar a garupa, aceitação com pressão firme na região lombar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Går att kontrollera utan hane: flaggning när du stryker över korset, står vid stadigt tryck på ländryggen."
          }
        }
      }
    },
    "Ohne Systemberechtigung kann Rudel nichts setzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without system permission, Rudel can't schedule anything."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder systeemtoestemming kan Rudel niets instellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans autorisation système, Rudel ne peut rien programmer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin permiso del sistema, Rudel no puede programar nada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza autorizzazione di sistema, Rudel non può impostare nulla."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem permissão do sistema, o Rudel não consegue agendar nada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan systembehörighet kan Rudel inte schemalägga något."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten systemtillatelse kan ikke Rudel planlegge noe."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden systemtilladelse kan Rudel ikke planlægge noget."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman järjestelmän lupaa Rudel ei voi ajastaa mitään."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの許可がないと、Rudelは何も設定できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 권한이 없으면 Rudel이 아무것도 설정할 수 없어요."
          }
        }
      }
    },
    "Ohne einen erfassten Tag 1 gibt es keinen Bezugspunkt und damit keine Prognose.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en registreret dag 1 er der intet referencepunkt og dermed ingen prognose."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a logged day 1 there's no reference point, so no forecast is possible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un día 1 registrado no hay punto de referencia y, por tanto, no hay previsión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman kirjattua päivää 1 ei ole vertailukohtaa eikä siten ennustetta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans jour 1 noté, il n'y a pas de point de référence, donc pas de prévision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un giorno 1 registrato non c'è un punto di riferimento e quindi nessuna previsione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日目が記録されていないと基準点がないため、予測できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1일차 기록이 없으면 기준점이 없어 예측할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en registrert dag 1 finnes det ikke noe referansepunkt og dermed ingen prognose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder vastgelegde dag 1 is er geen referentiepunt en dus geen prognose."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um dia 1 registrado, não há ponto de referência e, portanto, nenhuma previsão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en loggad dag 1 finns ingen referenspunkt och därmed ingen prognos."
          }
        }
      }
    },
