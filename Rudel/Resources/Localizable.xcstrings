    "Keine zusätzlichen Vorab-Mitteilungen. Alarme und Einzelgaben bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No extra advance notifications. Alarms and one-off doses stay."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen extra meldingen vooraf. Alarmen en losse toedieningen blijven."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de notification préalable supplémentaire. Les alarmes et les prises ponctuelles sont conservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin notificaciones previas adicionales. Las alarmas y las tomas puntuales se mantienen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna notifica di preavviso aggiuntiva. Le sveglie e le singole somministrazioni restano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem notificações antecipadas extras. Alarmes e doses avulsas continuam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga extra förhandsnotiser. Alarm och enstaka doser finns kvar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ekstra forhåndsvarsler. Alarmer og enkeltdoser blir værende."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen ekstra notifikationer på forhånd. Alarmer og enkeltdoser bevares."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei ylimääräisiä ennakkoilmoituksia. Hälytykset ja yksittäiset annokset säilyvät."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加の事前通知はありません。アラームと単発の投与はそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 사전 알림이 없어요. 알람과 1회성 투여 알림은 그대로예요."
          }
        }
      }
    },
