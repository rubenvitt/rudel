      }
    },
    "Abgesetzte Medikamente erzeugen keine Fälligkeiten mehr, ihre Historie bleibt erhalten.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seponeret medicin giver ingen nye forfaldsdatoer, historikken bevares."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discontinued medications no longer create due dates; their history is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los medicamentos suspendidos ya no generan fechas pendientes; su historial se conserva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopetetut lääkkeet eivät enää luo eräpäiviä, niiden historia säilyy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médicaments arrêtés ne génèrent plus d'échéances, leur historique est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I farmaci sospesi non generano più scadenze, la loro cronologia resta conservata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中止したお薬の予定は作成されなくなりますが、履歴は残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단된 약은 더 이상 예정일을 만들지 않으며, 기록은 유지돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluttede medisiner gir ingen nye forfallsdatoer, historikken beholdes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopte medicijnen krijgen geen geplande toedieningen meer, hun geschiedenis blijft bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicamentos suspensos não geram mais datas previstas; o histórico é mantido."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutade läkemedel ger inga fler förfallodatum, historiken sparas."
          }
        }
      }
    },
    "Abgesetzte Medikamente rutschen in den Bereich „Abgesetzt“. Ihre Historie bleibt vollständig erhalten.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Seponeret medicin flyttes til afsnittet »Seponeret«. Historikken bevares fuldt ud."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discontinued medications move to the “Discontinued” section. Their history is kept in full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los medicamentos suspendidos pasan a la sección «Suspendidos». Su historial se conserva por completo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lopetetut lääkkeet siirtyvät osioon ”Lopetetut”. Niiden historia säilyy kokonaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les médicaments arrêtés passent dans la section « Arrêtés ». Leur historique est entièrement conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I farmaci sospesi finiscono nella sezione «Sospesi». La loro cronologia resta completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中止したお薬は「中止済み」に移動します。履歴はすべて残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중단한 약은 ‘중단됨’ 영역으로 이동해요. 기록은 모두 유지돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Avsluttede medisiner flyttes til delen «Avsluttet». Historikken beholdes i sin helhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopte medicijnen verschuiven naar het gedeelte ‘Gestopt’. Hun geschiedenis blijft volledig bewaard."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicamentos suspensos vão para a seção “Suspensos”. O histórico é mantido por completo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avslutade läkemedel flyttas till avsnittet ”Avslutade”. Historiken sparas i sin helhet."
          }
        }
      }
    },
