    "Für Katzen gibt es keine Zyklusprognose, ihr Zyklus lässt sich nicht verlässlich vorhersagen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no cycle forecast for cats; their cycle can't be predicted reliably."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor katten is er geen cyclusprognose; hun cyclus is niet betrouwbaar te voorspellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas de prévision du cycle pour les chats : leur cycle ne peut pas être prévu de façon fiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay previsión del ciclo para gatos: su ciclo no se puede predecir de forma fiable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per i gatti non c'è previsione del ciclo: il loro ciclo non si può prevedere in modo affidabile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há previsão de ciclo para gatos: o ciclo deles não pode ser previsto com confiabilidade."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns ingen cykelprognos för katter, deras cykel går inte att förutsäga på ett tillförlitligt sätt."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finnes ingen syklusprognose for katter, syklusen deres kan ikke forutsies pålitelig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ingen cyklusprognose for katte, deres cyklus kan ikke forudsiges pålideligt."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kissoille ei ole kierron ennustetta, koska niiden kiertoa ei voi ennustaa luotettavasti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫の周期は確実に予測できないため、周期の予測はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이는 주기를 믿을 만하게 예측할 수 없어서 주기 예측을 제공하지 않아요."
          }
        }
      }
    },
    "Für alles,\nwas euch gut tut.": {
      "comment": "Welcome screen headline; 'euch' = owner and pet(s); keep the line break",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til alt\nder gør jer godt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For everything\nthat's good for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para todo\nlo que os hace bien."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaikkeen,\nmikä tekee teille hyvää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour tout\nce qui vous fait du bien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tutto\nciò che vi fa bene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたたちの\n毎日のために。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서로에게 좋은\n모든 것을 위해."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For alt\nsom gjør dere godt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor alles\nwat jullie goed doet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tudo\nque faz bem a vocês."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För allt\nsom gör er gott."
          }
        }
      }
    },
