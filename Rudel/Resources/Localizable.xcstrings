    "Jede Uhrzeit ist eine eigene Gabe pro Gabetag und wird einzeln abgehakt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert tidspunkt er en separat dosis pr. dosisdag og afkrydses enkeltvis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each time is a separate dose on every dosing day and is checked off individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada hora es una toma distinta por día de toma y se marca por separado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kellonaika on oma annoksensa jokaisena annospäivänä, ja se merkitään erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure correspond à une prise distincte par jour de traitement et se coche séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni orario è una somministrazione a sé per ogni giorno e si spunta singolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各時刻は投与日ごとの1回分として、個別にチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 시간은 투여일마다 별도의 투여로, 하나씩 체크해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert klokkeslett er en egen dose per dosedag og hukes av hver for seg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk tijdstip is een aparte toediening per toedieningsdag en wordt apart afgevinkt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada horário é uma dose separada por dia de dose e é marcado individualmente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje klockslag är en egen dos per dosdag och bockas av separat."
          }
        }
      }
    },
    "Jede Vorwarnzeit ist eine eigene Mitteilung.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each advance notice is a separate notification."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke voorwaarschuwing is een eigen melding."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque préavis est une notification distincte."
          }
        },
        "es": {
