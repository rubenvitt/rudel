    "Nur %@ Abstand zu Tag 1 am %@. Unter %lld Tagen ist der Abstand biologisch unplausibel — meist ein Tippfehler. Speichern ist trotzdem möglich.": {
      "comment": "1: Abstand (z. B. „12 Tage“), 2: Datum von Tag 1, 3: Untergrenze in Tagen (135)",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun %@ fra dag 1 den %@. Under %lld dage er intervallet biologisk usandsynligt – oftest en tastefejl. Du kan stadig gemme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only %@ after day 1 on %@. An interval under %lld days is biologically implausible – usually a typo. You can still save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ de diferencia con el día 1 del %@. Menos de %lld días es biológicamente improbable; suele ser un error de escritura. Aun así puedes guardar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vain %@ päivästä 1 (%@). Alle %lld päivän väli on biologisesti epätodennäköinen – yleensä kirjoitusvirhe. Voit silti tallentaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@ d'écart avec le jour 1 du %@. Un écart de moins de %lld jours est biologiquement invraisemblable – souvent une faute de frappe. L'enregistrement reste possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo %@ di distanza dal giorno 1 del %@. Sotto i %lld giorni la distanza è biologicamente poco plausibile, di solito un errore di battitura. Puoi salvare comunque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@の1日目から%1$@しか空いていません。%3$lld日未満の間隔は生物学的に考えにくく、多くは入力ミスです。それでも保存はできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 1일차와 %1$@밖에 차이 나지 않아요. %3$lld일 미만의 간격은 생물학적으로 드물어 대개 입력 실수예요. 그래도 저장할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bare %@ fra dag 1 den %@. Under %lld dager er intervallet biologisk usannsynlig – som regel en skrivefeil. Du kan likevel lagre."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Slechts %@ tussen dit en dag 1 op %@. Een interval onder %lld dagen is biologisch onwaarschijnlijk – meestal een typefout. Bewaren kan toch."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas %@ de distância do dia 1 em %@. Menos de %lld dias é biologicamente improvável; geralmente é um erro de digitação. Mesmo assim, você pode salvar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara %@ från dag 1 den %@. Under %lld dagar är intervallet biologiskt osannolikt – oftast ett skrivfel. Du kan ändå spara."
          }
        }
      }
    },
