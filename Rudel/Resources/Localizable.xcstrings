    "Geschätzt, kein Befund. Deine Beobachtungen zählen mehr als der Kalender.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et skøn, ikke en diagnose. Dine observationer tæller mere end kalenderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate, not a diagnosis. Your observations count for more than the calendar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación, no un diagnóstico. Tus observaciones cuentan más que el calendario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arvio, ei diagnoosi. Havaintosi painavat enemmän kuin kalenteri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation, pas un diagnostic. Vos observations comptent davantage que le calendrier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima, non una diagnosi. Le tue osservazioni contano più del calendario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "推定であり、診断ではありません。カレンダーよりあなたの観察のほうが重要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추정치일 뿐 진단이 아니에요. 달력보다 직접 관찰한 내용이 더 중요해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et anslag, ingen diagnose. Observasjonene dine teller mer enn kalenderen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een schatting, geen diagnose. Je waarnemingen tellen zwaarder dan de kalender."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma estimativa, não um diagnóstico. Suas observações valem mais do que o calendário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En uppskattning, ingen diagnos. Dina observationer väger tyngre än kalendern."
          }
        }
      }
    },
