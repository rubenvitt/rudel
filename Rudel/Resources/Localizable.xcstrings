          "stringUnit": {
            "state": "translated",
            "value": "Uppgifterna kunde inte sparas just nu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene kunne ikke lagres akkurat nå."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dataene kunne ikke gemmes lige nu."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tietoja ei voitu tallentaa juuri nyt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在データを保存できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 데이터를 저장할 수 없어요."
          }
        }
      }
    },
    "Die Erinnerung ließ sich nicht laden. Öffne sie in Rudel noch einmal.": {
      "comment": "Reminder confirmation sheet could not load its data",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reminder couldn't be loaded. Open it in Rudel again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herinnering kon niet worden geladen. Open hem opnieuw in Rudel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger le rappel. Ouvrez-le à nouveau dans Rudel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cargar el recordatorio. Vuelve a abrirlo en Rudel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile caricare il promemoria. Aprilo di nuovo in Rudel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar o lembrete. Abra-o novamente no Rudel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsen kunde inte läsas in. Öppna den i Rudel igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsen kunne ikke lastes inn. Åpne den i Rudel på nytt."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelsen kunne ikke indlæses. Åbn den i Rudel igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muistutusta ei voitu ladata. Avaa se uudelleen Rudelissa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを読み込めませんでした。Rudelでもう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리마인더를 불러올 수 없어요. Rudel에서 다시 열어 주세요."
          }
        }
      }
    },
    "Die Gabe ließ sich nicht speichern. Versuch es noch einmal.": {
      "comment": "Quick log could not save a dose",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dose couldn't be saved. Please try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toediening kon niet worden bewaard. Probeer het opnieuw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la prise. Veuillez réessayer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar la toma. Inténtalo de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare la somministrazione. Riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar a dose. Tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosen kunde inte sparas. Försök igen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosen kunne ikke lagres. Prøv igjen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosen kunne ikke gemmes. Prøv igen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Annosta ei voitu tallentaa. Yritä uudelleen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投与を保存できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투여 기록을 저장할 수 없어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "Die Klasse wirkt nur auf die Zyklusprognose und bleibt für dieses Tier ohne Effekt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The size class only affects the cycle forecast and has no effect for this pet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De grootteklasse werkt alleen op de cyclusprognose en heeft voor dit dier geen effect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le gabarit n'influe que sur la prévision du cycle et n'a aucun effet pour cet animal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño solo influye en la previsión del ciclo y no tiene efecto para esta mascota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La taglia influisce solo sulla previsione del ciclo e per questo animale non ha effetto."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O porte só afeta a previsão do ciclo e não tem efeito para este pet."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Storleksklassen påverkar bara cykelprognosen och har ingen effekt för det här djuret."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Størrelsesklassen påvirker bare syklusprognosen og har ingen effekt for dette dyret."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Størrelsesklassen påvirker kun cyklusprognosen og har ingen effekt for dette dyr."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokoluokka vaikuttaa vain kierron ennusteeseen, eikä sillä ole vaikutusta tälle lemmikille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ区分は周期の予測にのみ影響し、このペットには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기 등급은 주기 예측에만 영향을 주며 이 반려동물에게는 효과가 없어요."
          }
        }
      }
    },
    "Die Körperkondition folgt der 9-Punkte-Skala (WSAVA); 5 heißt idealgewichtig.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kropskonditionen følger 9-punktsskalaen (WSAVA); 5 betyder idealvægt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body condition uses the 9-point scale (WSAVA); 5 means ideal weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La condición corporal sigue la escala de 9 puntos (WSAVA); 5 significa peso ideal."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuntoluokka noudattaa 9-portaista asteikkoa (WSAVA); 5 tarkoittaa ihannepainoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état corporel suit l'échelle en 9 points (WSAVA) ; 5 correspond au poids idéal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condizione corporea segue la scala a 9 punti (WSAVA); 5 indica il peso ideale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボディコンディションは9段階評価(WSAVA)に基づきます。5が理想体重です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신체 상태는 9점 척도(WSAVA)를 따르며, 5는 이상 체중이에요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroppskondisjonen følger 9-punktsskalaen (WSAVA); 5 betyr idealvekt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lichaamsconditie volgt de 9-puntsschaal (WSAVA); 5 betekent ideaal gewicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A condição corporal segue a escala de 9 pontos (WSAVA); 5 significa peso ideal."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kroppskonditionen följer 9-gradersskalan (WSAVA); 5 betyder idealvikt."
          }
        }
      }
    },
    "Die Läufigkeit vom %@ hat kein Enddatum. Die Prognose funktioniert trotzdem — sie hängt nur am Tag-1-Anker.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løbetiden fra %@ har ingen slutdato. Prognosen virker alligevel – den bygger kun på dag 1."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The heat from %@ has no end date. The forecast still works – it only depends on the day 1 anchor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El celo del %@ no tiene fecha de fin. La previsión funciona igualmente: solo depende del día 1 como referencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiimalla %@ ei ole päättymispäivää. Ennuste toimii silti – se perustuu vain päivään 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chaleurs du %@ n'ont pas de date de fin. La prévision fonctionne quand même : elle ne dépend que du jour 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calore del %@ non ha una data di fine. La previsione funziona comunque: dipende solo dal giorno 1 come riferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@からのヒートには終了日がありません。それでも予測は機能します。予測は1日目だけを基準にしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 시작된 발정에 종료일이 없어요. 그래도 예측은 가능해요. 예측은 1일차만 기준으로 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løpetiden fra %@ mangler sluttdato. Prognosen fungerer likevel – den bygger bare på dag 1."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De loopsheid van %@ heeft geen einddatum. De prognose werkt toch – die hangt alleen af van dag 1 als ankerpunt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O cio de %@ não tem data de término. A previsão funciona mesmo assim: ela depende apenas do dia 1 como referência."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Löpet från %@ saknar slutdatum. Prognosen fungerar ändå – den utgår bara från dag 1."
          }
        }
      }
    },
    "Die Läufigkeit wird nur für unkastrierte Hündinnen geführt. Für andere Tiere ist kein Zyklustracking verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heat cycles are only tracked for intact female dogs. Cycle tracking isn't available for other pets."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Loopsheid wordt alleen bijgehouden voor niet-gecastreerde teven. Voor andere dieren is geen cyclustracking beschikbaar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chaleurs ne sont suivies que pour les femelles non stérilisées. Le suivi du cycle n'est pas disponible pour les autres animaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El celo solo se registra en hembras no esterilizadas. Para otras mascotas no hay seguimiento del ciclo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calore viene registrato solo per le femmine non sterilizzate. Per gli altri animali il monitoraggio del ciclo non è disponibile."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O cio só é acompanhado em fêmeas não castradas. Para outros pets, o acompanhamento do ciclo não está disponível."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Löp följs bara för okastrerade tikar. För andra djur finns ingen cykelspårning."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Løpetid føres bare for ukastrerte tisper. For andre dyr er syklussporing ikke tilgjengelig."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Løbetid registreres kun for ukastrerede tæver. For andre dyr er cyklussporing ikke tilgængelig."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiimaa seurataan vain steriloimattomilla nartuilla. Muille lemmikeille kierron seuranta ei ole käytettävissä."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒートの記録は避妊していないメス犬のみが対象です。ほかのペットでは周期の記録は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발정은 중성화하지 않은 암컷 개에 대해서만 기록해요. 다른 반려동물은 주기 추적을 사용할 수 없어요."
          }
        }
      }
    },
    "Die Prognose steht auf Populationswerten: %@. Ab der nächsten erfassten Läufigkeit rechnet die App mit dem eigenen Abstand.": {
      "comment": "%@ = Populations-Durchschnitt, z. B. „Ø 210 Tage (135–300)“",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen bygger på populationsværdier: %@. Fra næste registrerede løbetid regner appen med hendes eget interval."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The forecast is based on population averages: %@. From the next logged heat on, the app uses her own interval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La previsión se basa en promedios de población: %@. A partir del próximo celo registrado, la app usa su propio intervalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ennuste perustuu populaation keskiarvoihin: %@. Seuraavasta kirjatusta kiimasta alkaen sovellus käyttää lemmikin omaa väliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prévision repose sur des moyennes de population : %@. Dès les prochaines chaleurs enregistrées, l'app utilise son propre intervalle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La previsione si basa su medie di popolazione: %@. Dal prossimo calore registrato, l'app usa il suo intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予測は統計上の平均値（%@）にもとづいています。次のヒートを記録すると、この子自身の間隔で計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예측은 집단 평균값(%@)을 바탕으로 해요. 다음 발정을 기록하면 이 아이의 실제 간격으로 계산해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen bygger på populasjonsverdier: %@. Fra neste registrerte løpetid regner appen med hennes eget intervall."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prognose is gebaseerd op populatiegemiddelden: %@. Vanaf de volgende vastgelegde loopsheid rekent de app met haar eigen interval."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A previsão se baseia em médias populacionais: %@. A partir do próximo cio registrado, o app usa o intervalo dela."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prognosen bygger på populationsvärden: %@. Från nästa loggade löp räknar appen med hennes eget intervall."
          }
        }
      }
    },
    "Diese Einträge sind die Rechengrundlage: die Fälligkeiten kommen aus den Gaben, die Zyklusprognose aus den Tag-1-Daten der Läufigkeiten. Je mehr eigene Zyklen erfasst sind, desto engere Spannen zeigt Rudel.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These entries are what Rudel calculates with: due dates come from the doses, the cycle forecast from the day-1 dates of the heat cycles. The more of your pet's own cycles are recorded, the narrower the ranges Rudel shows."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze gegevens rekent Rudel: de geplande data komen uit de toedieningen, de cyclusprognose uit de dag-1-data van de loopsheden. Hoe meer eigen cycli zijn vastgelegd, hoe smaller de marges die Rudel toont."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données servent de base aux calculs : les échéances découlent des prises, la prévision du cycle des dates du jour 1 des chaleurs. Plus vous enregistrez de cycles, plus les fourchettes affichées par Rudel sont étroites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos registros son la base de los cálculos: las fechas previstas salen de las tomas y la previsión del ciclo, de las fechas del día 1 de cada celo. Cuantos más ciclos propios registres, más estrechos serán los márgenes que muestra Rudel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dati sono la base dei calcoli: le scadenze derivano dalle somministrazioni, la previsione del ciclo dalle date del giorno 1 dei calori. Più cicli registri, più strette saranno le fasce mostrate da Rudel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes registros são a base dos cálculos: as datas previstas vêm das doses, e a previsão do ciclo, das datas do dia 1 de cada cio. Quanto mais ciclos você registrar, mais estreitas as faixas que o Rudel mostra."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här posterna är beräkningsunderlaget: när något är dags räknas fram ur doserna, cykelprognosen ur dag 1 för varje löp. Ju fler egna cykler som är registrerade, desto smalare intervall visar Rudel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse registreringene er beregningsgrunnlaget: forfallsdatoene kommer fra dosene, syklusprognosen fra dag 1-datoene for løpetidene. Jo flere egne sykluser som er registrert, desto smalere intervaller viser Rudel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse registreringer er beregningsgrundlaget: forfaldsdatoerne kommer fra doserne, cyklusprognosen fra dag 1-datoerne for løbetiderne. Jo flere egne cyklusser der er registreret, desto smallere intervaller viser Rudel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä merkinnät ovat laskennan perusta: erääntymiset lasketaan annoksista, kierron ennuste kiimojen 1. päivän päivämääristä. Mitä enemmän omia kiertoja on merkitty, sitä kapeampia vaihteluvälejä Rudel näyttää."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの記録が計算の基礎になります。予定日は投与記録から、周期の予測は各ヒートの1日目から算出されます。記録した周期が多いほど、Rudelが示す幅は狭くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록이 계산의 바탕이 돼요. 예정일은 투여 기록에서, 주기 예측은 각 발정의 1일차 날짜에서 계산돼요. 기록된 주기가 많을수록 Rudel이 보여 주는 범위가 좁아져요."
          }
        }
      }
    },
    "Diese Einträge sind die Rechengrundlage: die Fälligkeiten kommen aus den Gaben. Je länger die Historie, desto belastbarer die Prognose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These entries are what Rudel calculates with: due dates come from the doses. The longer the history, the more reliable the forecast."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met deze gegevens rekent Rudel: de geplande data komen uit de toedieningen. Hoe langer de geschiedenis, hoe betrouwbaarder de prognose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces données servent de base aux calculs : les échéances découlent des prises. Plus l'historique est long, plus la prévision est fiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos registros son la base de los cálculos: las fechas previstas salen de las tomas. Cuanto más largo el historial, más fiable la previsión."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dati sono la base dei calcoli: le scadenze derivano dalle somministrazioni. Più lunga è la cronologia, più affidabile è la previsione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes registros são a base dos cálculos: as datas previstas vêm das doses. Quanto mais longo o histórico, mais confiável a previsão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De här posterna är beräkningsunderlaget: när något är dags räknas fram ur doserna. Ju längre historik, desto säkrare prognos."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse registreringene er beregningsgrunnlaget: forfallsdatoene kommer fra dosene. Jo lengre historikk, desto mer pålitelig prognose."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse registreringer er beregningsgrundlaget: forfaldsdatoerne kommer fra doserne. Jo længere historik, desto mere pålidelig prognose."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä merkinnät ovat laskennan perusta: erääntymiset lasketaan annoksista. Mitä pidempi historia, sitä luotettavampi ennuste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの記録が計算の基礎になります。予定日は投与記録から算出されます。履歴が長いほど予測の精度が上がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기록이 계산의 바탕이 돼요. 예정일은 투여 기록에서 계산돼요. 기록이 길수록 예측이 더 믿을 만해져요."
          }
        }
      }
    },
    "Diese Erinnerung ist bereits erledigt oder wurde durch einen geänderten Plan ersetzt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Påmindelsen er allerede håndteret eller erstattet af en ændret plan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This reminder has already been handled or was replaced by a changed plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recordatorio ya se completó o fue reemplazado por un plan modificado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä muistutus on jo hoidettu tai korvattu muutetulla suunnitelmalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce rappel a déjà été traité ou remplacé par un plan modifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo promemoria è già stato gestito o sostituito da un piano modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリマインダーは完了済みか、変更されたプランに置き換えられました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 리마인더는 이미 처리되었거나 변경된 계획으로 대체되었어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsen er allerede håndtert eller erstattet av en endret plan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herinnering is al afgehandeld of vervangen door een gewijzigd plan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lembrete já foi concluído ou substituído por um plano alterado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminnelsen är redan hanterad eller har ersatts av en ändrad plan."
          }
        }
      }
    },
    "Diese Erinnerungen hat iOS nicht angenommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS didn't accept these reminders."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze herinneringen heeft iOS niet geaccepteerd."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS n'a pas accepté ces rappels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS no aceptó estos recordatorios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS non ha accettato questi promemoria."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS não aceitou estes lembretes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS godtog inte de här påminnelserna."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS godtok ikke disse påminnelsene."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS accepterede ikke disse påmindelser."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ei hyväksynyt näitä muistutuksia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSがこれらのリマインダーを受け付けませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS가 이 리마인더를 받아들이지 않았어요."
          }
        }
      }
    },
    "Diese Gabe gehört nicht mehr zum aktuellen Plan. Bitte prüfe die Medikamentenliste.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne dosis hører ikke længere til den aktuelle plan. Tjek medicinlisten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This dose no longer belongs to the current plan. Please check the medication list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta toma ya no pertenece al plan actual. Revisa la lista de medicamentos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä annos ei enää kuulu nykyiseen suunnitelmaan. Tarkista lääkeluettelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette prise ne fait plus partie du plan actuel. Veuillez vérifier la liste des médicaments."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa somministrazione non fa più parte del piano attuale. Controlla l'elenco dei farmaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この投与は現在のプランに含まれていません。お薬の一覧を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 투여는 더 이상 현재 계획에 속하지 않아요. 약 목록을 확인해 주세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne dosen hører ikke lenger til gjeldende plan. Sjekk medisinlisten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze toediening hoort niet meer bij het huidige plan. Controleer de medicijnlijst."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dose não pertence mais ao plano atual. Verifique a lista de medicamentos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosen hör inte längre till den aktuella planen. Kontrollera läkemedelslistan."
          }
        }
      }
    },
