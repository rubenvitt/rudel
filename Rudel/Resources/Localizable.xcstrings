    "Löscht das Profil samt aller Gaben, Tierarzttermine, Läufigkeiten, Symptome und Gewichtseinträge.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the profile along with all doses, vet appointments, heat cycles, symptoms and weight entries."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert het profiel met alle toedieningen, dierenartsafspraken, loopsheden, symptomen en gewichtsmetingen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le profil ainsi que toutes les prises, rendez-vous vétérinaires, chaleurs, symptômes et pesées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el perfil junto con todas las tomas, citas veterinarias, celos, síntomas y registros de peso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina il profilo con tutte le somministrazioni, gli appuntamenti veterinari, i calori, i sintomi e le pesate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga o perfil com todas as doses, consultas veterinárias, cios, sintomas e registros de peso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Raderar profilen med alla doser, veterinärbesök, löp, symtom och viktposter."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter profilen med alle doser, veterinærtimer, løpetider, symptomer og vektregistreringer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter profilen med alle doser, dyrlægetider, løbetider, symptomer og vægtregistreringer."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa profiilin sekä kaikki annokset, eläinlääkäriajat, kiimat, oireet ja painomerkinnät."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールと、すべての投与・動物病院の予約・ヒート・症状・体重記録を削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필과 모든 투여, 동물병원 예약, 발정, 증상, 체중 기록을 삭제합니다."
          }
        }
      }
    },
