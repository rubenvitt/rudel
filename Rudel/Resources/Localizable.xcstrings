    "Medikamente und Schutzintervalle mit Erinnerungen.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicin og beskyttelsesintervaller med påmindelser."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medications and protection intervals with reminders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicamentos e intervalos de protección con recordatorios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lääkkeet ja suojausvälit muistutuksineen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Médicaments et intervalles de protection avec rappels."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Farmaci e intervalli di protezione con promemoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お薬と予防の間隔をリマインダーでお知らせ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약과 예방 주기를 알림으로 챙겨요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medisiner og beskyttelsesintervaller med påminnelser."
          }
        },
        "nl": {
          "stringUnit": {
