            "value": "Ogni preavviso è una notifica separata."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada aviso antecipado é uma notificação separada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje förvarning är en egen notis."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert forvarsel er et eget varsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert forvarsel er en separat notifikation."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen ennakkoilmoitus on oma ilmoituksensa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前通知はそれぞれ別の通知として届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사전 알림은 각각 별도의 알림으로 와요."
          }
        }
      }
    },
    "Jede erfasste Gabe zieht die Menge je Gabe ab.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver registreret dosis trækker mængden pr. dosis fra."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each logged dose deducts the amount per dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada toma registrada descuenta la cantidad por toma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jokainen kirjattu annos vähentää annoksen määrän."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque prise enregistrée déduit la quantité par prise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni somministrazione registrata scala la quantità per somministrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投与を記録するたびに1回の量が差し引かれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "투여를 기록할 때마다 1회 투여량이 차감돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver registrerte dose trekker fra mengden per dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke vastgelegde toediening trekt de hoeveelheid per toediening af."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dose registrada desconta a quantidade por dose."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje loggad dos drar av mängden per dos."
          }
        }
      }
    },
