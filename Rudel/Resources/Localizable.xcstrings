    "Alarme gibt es nur für zeitkritische Medikamente. Eine Gabe ist erst erledigt, wenn du sie bestätigst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms are only available for time-critical medications. A dose isn't done until you confirm it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmen zijn er alleen voor tijdkritische medicijnen. Een toediening is pas afgerond als je die bevestigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes ne concernent que les médicaments à heure fixe. Une prise n'est validée que lorsque vous la confirmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay alarmas para medicamentos en los que la hora es crítica. Una toma no se da por hecha hasta que la confirmas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie sono disponibili solo per i farmaci con orari critici. Una somministrazione è completata solo quando la confermi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes existem só para medicamentos com horário crítico. Uma dose só fica concluída quando você a confirma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm finns bara för tidskritiska läkemedel. En dos är klar först när du bekräftar den."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmer finnes bare for tidskritiske medisiner. En dose er først fullført når du bekrefter den."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmer findes kun for tidskritisk medicin. En dosis er først udført, når du bekræfter den."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hälytykset ovat käytössä vain aikakriittisille lääkkeille. Annos on tehty vasta, kun vahvistat sen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームは時間が重要なお薬にのみ設定されます。投与は確認するまで完了になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람은 시간이 중요한 약에만 있어요. 투여는 확인해야 완료돼요."
          }
        }
      }
    },
    "Alle %@ nach der letzten Gabe.": {
      "comment": "%@ = Dauer wie „90 Tage“",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver %@ efter sidste dosis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %@, counted from the last dose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada %@ desde la última toma."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viimeisen annoksen jälkeen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les %@ après la dernière prise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni %@ dopo l'ultima somministrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の投与から%@ごと。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 투여 후 %@마다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver %@ etter siste dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke %@ na de laatste toediening."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada %@ após a última dose."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var %@ efter senaste dosen."
          }
        }
      }
    },
