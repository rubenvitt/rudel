    "Ein Dauermedikament wird nicht als Ganzes fällig, sondern Gabe für Gabe abgehakt.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En fast medicin forfalder ikke samlet, men afkrydses dosis for dosis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A long-term medication isn't due as a whole; each dose is checked off individually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un medicamento de uso continuo no vence en conjunto: cada toma se marca por separado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitkäaikaislääkkeellä ei ole yhtä eräpäivää, vaan jokainen annos merkitään erikseen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un traitement au long cours n'a pas d'échéance globale : chaque prise est cochée individuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un farmaco continuativo non scade nel suo insieme: ogni somministrazione si spunta singolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常用薬は全体での予定日を持たず、1回ずつチェックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상시 복용약은 한 번에 예정되지 않고, 투여마다 하나씩 체크해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En langtidsmedisin forfaller ikke som helhet, men hukes av dose for dose."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een langdurig medicijn wordt niet in zijn geheel gepland, maar per toediening afgevinkt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um medicamento contínuo não vence como um todo: cada dose é marcada individualmente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett långtidsläkemedel förfaller inte som helhet, utan bockas av dos för dos."
          }
        }
      }
    },
    "Ein Name reicht. Den Rest kannst du später ergänzen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name is enough. You can add the rest later."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam is genoeg. De rest kun je later aanvullen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom suffit. Vous pourrez compléter le reste plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con un nombre. El resto puedes completarlo más tarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta un nome. Il resto puoi aggiungerlo dopo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome basta. O resto você pode completar depois."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett namn räcker. Resten kan du fylla i senare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et navn holder. Resten kan du fylle inn senere."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et navn er nok. Resten kan du udfylde senere."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimi riittää. Loput voit täydentää myöhemmin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前だけで大丈夫です。ほかの項目はあとから追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 있으면 돼요. 나머지는 나중에 채울 수 있어요."
          }
        }
      }
    },
    "Ein Tap auf einen Haken nimmt ihn wieder zurück.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et flueben for at fortryde det."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a checkmark to undo it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una marca para deshacerla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta valintamerkkiä peruaksesi sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une coche pour l'annuler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un segno di spunta per annullarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックマークをタップすると取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체크 표시를 탭하면 취소돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på en hake for å angre den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een vinkje om het ongedaan te maken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma marca de seleção para desfazê-la."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på en bock för att ångra den."
          }
        }
      }
    },
    "Ein zweites Wiegen genügt, dann wird die Kurve gezeichnet.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én vejning mere er nok, så tegnes kurven."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One more weigh-in and the chart will be drawn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta con un segundo pesaje para dibujar la curva."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi punnitus lisää riittää, niin käyrä piirretään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une deuxième pesée suffit pour tracer la courbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta una seconda pesata per disegnare la curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度量れば、グラフが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 더 재면 그래프가 그려져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én veiing til er nok, så tegnes kurven."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog één keer wegen en de grafiek wordt getekend."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uma segunda pesagem para desenhar a curva."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En vägning till räcker, sedan ritas kurvan."
          }
        }
      }
    },
    "Eine Beobachtung braucht einen Tag-1-Anker, sonst hat sie keinen Tag im Zyklus.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En observation kræver en dag 1 som udgangspunkt, ellers har den ingen dag i cyklussen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An observation needs a day 1 anchor – otherwise it has no day in the cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una observación necesita un día 1 como referencia; si no, no tiene día en el ciclo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Havainto tarvitsee päivän 1 lähtökohdaksi, muuten sillä ei ole päivää kierrossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une observation a besoin d'un jour 1 comme référence, sinon elle n'a pas de jour dans le cycle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'osservazione ha bisogno di un giorno 1 come riferimento, altrimenti non ha un giorno nel ciclo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観察には基準となる1日目が必要です。ないと周期の何日目か決まりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관찰에는 기준이 되는 1일차가 필요해요. 없으면 주기에서 며칠째인지 정할 수 없어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En observasjon trenger en dag 1 som utgangspunkt, ellers har den ingen dag i syklusen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een waarneming heeft dag 1 als ankerpunt nodig, anders heeft ze geen dag in de cyclus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma observação precisa de um dia 1 como referência; caso contrário, ela não tem um dia no ciclo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En observation behöver en dag 1 som utgångspunkt, annars har den ingen dag i cykeln."
          }
        }
      }
    },
    "Eine kleine Auffälligkeit, ein Foto, eine Beobachtung. Hier entsteht die Geschichte, die dir beim Tierarzt hilft.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En lille ændring, et foto, en observation. Her opstår historikken, der hjælper dig hos dyrlægen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small change, a photo, an observation. This is where the history comes together that helps you at the vet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un pequeño detalle, una foto, una observación. Aquí se crea la historia que te ayudará en el veterinario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pieni poikkeama, kuva, havainto. Tästä syntyy historia, joka auttaa sinua eläinlääkärillä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un petit détail inhabituel, une photo, une observation. Ici se construit l'historique qui vous aidera chez le vétérinaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una piccola anomalia, una foto, un'osservazione. Qui nasce la storia che ti aiuterà dal veterinario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっとした変化、写真、気づいたこと。ここに記録がたまり、動物病院で役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 변화, 사진 한 장, 관찰 하나. 여기서 동물병원에서 도움이 될 기록이 쌓여요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten endring, et bilde, en observasjon. Her vokser historikken frem som hjelper deg hos veterinæren."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iets kleins dat opvalt, een foto, een observatie. Hier ontstaat het verhaal dat je helpt bij de dierenarts."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno sinal, uma foto, uma observação. Aqui nasce o histórico que vai ajudar você no veterinário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En liten avvikelse, ett foto, en observation. Här växer historiken fram som hjälper dig hos veterinären."
          }
        }
      }
    },
