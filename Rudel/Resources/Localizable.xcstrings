    "Erste erfasste Läufigkeit. Bis zum nächsten Tag 1 rechnet die App mit Populationswerten.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Første registrerede løbetid. Indtil næste dag 1 regner appen med populationsværdier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First logged heat. Until the next day 1, the app uses population averages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primer celo registrado. Hasta el próximo día 1, la app usa promedios de población."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensimmäinen kirjattu kiima. Seuraavaan päivään 1 asti sovellus käyttää populaation keskiarvoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premières chaleurs enregistrées. Jusqu'au prochain jour 1, l'app utilise des moyennes de population."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Primo calore registrato. Fino al prossimo giorno 1, l'app usa medie di popolazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めて記録するヒートです。次の1日目までは統計上の平均値で計算します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 기록하는 발정이에요. 다음 1일차 전까지는 집단 평균값으로 계산해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Første registrerte løpetid. Frem til neste dag 1 regner appen med populasjonsverdier."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste vastgelegde loopsheid. Tot de volgende dag 1 rekent de app met populatiegemiddelden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
