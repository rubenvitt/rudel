    "Tag 1 vom %@ und %@ werden entfernt. Das verändert jede Prognose, die auf diesem Anker beruht.": {
      "comment": "Löschbestätigung. 1: Datum von Tag 1, 2: Anzahl Beobachtungen (z. B. „3 Beobachtungen“)",
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dag 1 den %@ og %@ fjernes. Det ændrer alle prognoser, der bygger på dette udgangspunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day 1 on %@ and %@ will be removed. This changes every forecast based on this anchor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán el día 1 del %@ y %@. Esto cambia todas las previsiones basadas en este punto de referencia."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Päivä 1 (%@) ja %@ poistetaan. Se muuttaa kaikkia ennusteita, jotka perustuvat tähän lähtöpäivään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour 1 du %@ et %@ seront supprimés. Cela modifie toutes les prévisions basées sur ce point de référence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno 1 del %@ e %@ verranno rimossi. Questo cambia ogni previsione basata su questo riferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の1日目と%@が削除されます。この基準日にもとづくすべての予測が変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 1일차와 %@이(가) 삭제돼요. 이 기준일을 바탕으로 한 모든 예측이 바뀌어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dag 1 den %@ og %@ fjernes. Det endrer hver prognose som bygger på dette utgangspunktet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dag 1 op %@ en %@ worden verwijderd. Dat verandert elke prognose die op dit ankerpunt is gebaseerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia 1 de %@ e %@ serão removidos. Isso altera todas as previsões baseadas nessa referência."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dag 1 den %@ och %@ tas bort. Det ändrar varje prognos som bygger på den här utgångspunkten."
          }
        }
      }
    },
