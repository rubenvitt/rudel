    "Medikamentenalarme ließen sich gerade nicht aktualisieren. Rudel versucht es beim nächsten Öffnen erneut.": {
      "comment": "Shown when medication alarms could not be updated",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medication alarms couldn't be updated right now. Rudel will try again the next time you open it."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnalarmen konden nu niet worden bijgewerkt. Rudel probeert het opnieuw wanneer je de app weer opent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes de médicaments n'ont pas pu être mises à jour. Rudel réessaiera à la prochaine ouverture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han podido actualizar las alarmas de medicamentos. Rudel lo volverá a intentar la próxima vez que lo abras."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare le sveglie dei farmaci. Rudel riproverà alla prossima apertura."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar os alarmes de medicamentos agora. O Rudel tentará de novo na próxima vez que você abrir o app."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läkemedelsalarmen kunde inte uppdateras just nu. Rudel försöker igen nästa gång du öppnar appen."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medisinalarmene kunne ikke oppdateres akkurat nå. Rudel prøver igjen neste gang du åpner appen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicinalarmerne kunne ikke opdateres lige nu. Rudel prøver igen, næste gang du åbner appen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lääkehälytyksiä ei voitu nyt päivittää. Rudel yrittää uudelleen, kun avaat sovelluksen seuraavan kerran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お薬アラームを更新できませんでした。次回アプリを開いたときに再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 알람을 지금 업데이트할 수 없어요. 다음에 앱을 열 때 다시 시도할게요."
          }
        }
      }
    },
    "Medikamentenalarme sind nicht erlaubt. Aktuell sind nur normale Mitteilungen möglich.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicinalarmer er ikke tilladt. Lige nu er kun almindelige notifikationer mulige."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Medication alarms aren't allowed. Only regular notifications are possible right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alarmas de medicamentos no están permitidas. Por ahora solo hay notificaciones normales."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lääkehälytykset eivät ole sallittuja. Tällä hetkellä vain tavalliset ilmoitukset ovat mahdollisia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alarmes de médicaments ne sont pas autorisées. Seules les notifications classiques sont possibles pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sveglie dei farmaci non sono consentite. Al momento sono possibili solo notifiche normali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お薬のアラームが許可されていません。現在は通常の通知のみ利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 알람이 허용되지 않았어요. 지금은 일반 알림만 가능해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Medisinalarmer er ikke tillatt. Akkurat nå er bare vanlige varsler mulig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicijnalarmen zijn niet toegestaan. Op dit moment zijn alleen gewone meldingen mogelijk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alarmes de medicamentos não estão permitidos. No momento, só notificações normais são possíveis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läkemedelsalarm är inte tillåtna. Just nu går det bara med vanliga notiser."
          }
        }
      }
    },
