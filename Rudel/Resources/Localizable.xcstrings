    "Fruchtbare Phase. Ausfluss wird strohfarben, Vulva weicher, Duldungsbereitschaft.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Frugtbar fase. Udflådet bliver stråfarvet, vulva blødere, hun står for parring."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertile phase. Discharge turns straw-colored, vulva softer, she accepts mating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase fértil. El flujo se vuelve color paja, la vulva más blanda, acepta la monta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedelmällinen vaihe. Vuoto muuttuu oljenväriseksi, ulkosynnytin pehmenee, narttu hyväksyy astutuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Phase fertile. Les pertes deviennent couleur paille, la vulve s'assouplit, elle accepte la saillie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase fertile. Le perdite diventano color paglia, la vulva più morbida, accetta l'accoppiamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "妊娠可能な時期。おりものが麦わら色になり、外陰部がやわらかくなり、交配を受け入れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가임기예요. 분비물이 볏짚색으로 변하고 외음부가 부드러워지며 교배를 허용해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fruktbar fase. Utfloden blir stråfarget, vulva mykere, hun står for parring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vruchtbare fase. Afscheiding wordt strokleurig, vulva zachter, ze laat zich dekken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fase fértil. O corrimento fica cor de palha, a vulva mais macia, ela aceita a cruza."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fertil fas. Flytningarna blir halmfärgade, vulvan mjukare, hon står för parning."
          }
        }
      }
    },
