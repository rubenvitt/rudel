    "So siehst du später, ob die Behandlung geholfen hat.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så kan du senere se, om behandlingen hjalp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That way you'll see later whether the treatment helped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así verás más tarde si el tratamiento ha ayudado."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näin näet myöhemmin, auttoiko hoito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous verrez ainsi plus tard si le traitement a aidé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così vedrai in seguito se il trattamento ha aiutato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "治療が効いたかどうか、あとで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 치료가 도움이 됐는지 확인할 수 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Da ser du senere om behandlingen hjalp."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zo zie je later of de behandeling heeft geholpen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim você vê depois se o tratamento ajudou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så ser du senare om behandlingen hjälpte."
          }
        }
      }
    },
    "Sobald eigene Intervalle geloggt sind, überstimmen sie diesen Startwert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once your pet's own intervals are logged, they override this starting value."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zodra er eigen intervallen zijn vastgelegd, gaan die voor deze startwaarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que des intervalles propres sont enregistrés, ils remplacent cette valeur de départ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto registres intervalos propios, sustituirán este valor inicial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non appena registri intervalli propri, sostituiscono questo valore iniziale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que intervalos próprios forem registrados, eles substituem esse valor inicial."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så snart egna intervall är registrerade går de före det här startvärdet."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så snart egne intervaller er registrert, overstyrer de denne startverdien."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så snart egne intervaller er registreret, tilsidesætter de denne startværdi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun omia välejä on kirjattu, ne ohittavat tämän lähtöarvon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の間隔が記録されると、そちらがこの初期値より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 간격이 기록되면 이 시작값보다 우선해요."
          }
        }
      }
    },
    "Solange der Termin geplant ist, übernimmt er die Erinnerung der Vorsorge.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så længe tiden er planlagt, overtager den påmindelsen for denne forebyggelse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While the appointment is planned, it takes over the reminder for this preventive care."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras la cita esté programada, sustituye el recordatorio de esta prevención."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Niin kauan kuin aika on suunniteltu, se korvaa tämän ennaltaehkäisyn muistutuksen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le rendez-vous est prévu, il remplace le rappel de cette prévention."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché l'appuntamento è programmato, sostituisce il promemoria di questa prevenzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約が予定のあいだは、この予防のリマインダーの代わりになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약이 예정 상태인 동안에는 이 예방 알림을 대신해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Så lenge timen er planlagt, overtar den påminnelsen for denne forebyggingen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zolang de afspraak gepland is, neemt die de herinnering van de preventieve zorg over."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enquanto a consulta estiver agendada, ela assume o lembrete desta prevenção."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Så länge besöket är planerat ersätter det påminnelsen för den här behandlingen."
          }
        }
      }
    },
