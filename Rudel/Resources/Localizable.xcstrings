    "Nur ausfüllen, wenn etwas anderes als im Plan gegeben wurde. Leer heißt: wie geplant.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udfyld kun, hvis der blev givet noget andet end planlagt. Tomt betyder: som planlagt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only fill in if something other than planned was given. Empty means: as planned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellénalo solo si se administró algo distinto a lo planificado. Vacío significa: según lo previsto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Täytä vain, jos annettiin jotain muuta kuin suunniteltiin. Tyhjä tarkoittaa: suunnitelman mukaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À remplir uniquement si autre chose que prévu a été administré. Vide signifie : comme prévu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila solo se è stato somministrato qualcosa di diverso dal piano. Vuoto significa: come previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランと異なるものを投与した場合のみ入力してください。空欄はプラン通りという意味です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획과 다른 것을 투여했을 때만 입력하세요. 비워 두면 계획대로예요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll bare ut hvis noe annet enn planlagt ble gitt. Tomt betyr: som planlagt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen invullen als er iets anders dan gepland is gegeven. Leeg betekent: zoals gepland."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha só se foi administrado algo diferente do plano. Vazio significa: conforme planejado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll bara i om något annat än planerat gavs. Tomt betyder: enligt plan."
          }
        }
      }
    },
    "Nur eintragen, was tierärztlich bestimmt wurde.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast kun værdier, som dyrlægen har målt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only enter values measured by a vet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce solo valores determinados por el veterinario."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Syötä vain eläinlääkärin määrittämät arvot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisissez que des valeurs mesurées par un vétérinaire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci solo valori rilevati dal veterinario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動物病院で測定した値だけを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동물병원에서 측정한 수치만 입력하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll bare inn verdier som veterinæren har målt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul alleen in wat de dierenarts heeft bepaald."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira apenas valores medidos pelo veterinário."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyll bara i värden som veterinären har tagit fram."
          }
        }
      }
    },
