    "Kein Konto, kein Server. Dein iCloud- oder Geräte-Backup sichert die Einträge mit.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto, ingen server. Din iCloud- eller enhedssikkerhedskopi gemmer også registreringerne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no server. Your iCloud or device backup includes your entries."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta ni servidor. Tu copia de seguridad de iCloud o del dispositivo incluye los registros."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei tiliä, ei palvelinta. iCloud- tai laitteen varmuuskopio tallentaa myös merkinnät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni compte, ni serveur. Votre sauvegarde iCloud ou de l'appareil inclut vos entrées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun server. Il backup di iCloud o del dispositivo include le registrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントもサーバーも不要です。iCloudまたはデバイスのバックアップに記録も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도 서버도 없어요. iCloud 또는 기기 백업에 기록이 함께 저장돼요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto, ingen server. iCloud- eller enhetssikkerhetskopien din tar med oppføringene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen account, geen server. Je iCloud- of apparaatreservekopie bewaart de gegevens mee."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta, sem servidor. O backup do iCloud ou do dispositivo inclui seus registros."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto, ingen server. Din iCloud- eller enhetssäkerhetskopia tar med posterna."
          }
        }
      }
    },
