    "Im Diöstrus-Nachlauf möglich: geschwollenes Gesäuge, Milchbildung, Nestbau, Verhaltensänderung.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Muligt i diøstrus bagefter: hævet yver, mælkedannelse, redebygning, ændret adfærd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible during diestrus afterward: swollen mammary glands, milk production, nesting, behavior changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posible durante el diestro posterior: mamas hinchadas, producción de leche, construcción de nido, cambios de conducta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahdollista sitä seuraavassa diestruksessa: turvonneet nisät, maidoneritys, pesänrakennus, käytöksen muutokset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Possible pendant le dioestrus qui suit : mamelles gonflées, montée de lait, comportement de nidification, changement de comportement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possibile durante il diestro successivo: mammelle gonfie, produzione di latte, preparazione del nido, cambiamenti di comportamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後の発情休止期に起こることがあります：乳腺の腫れ、乳汁の分泌、巣作り、行動の変化。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 발정후기에 나타날 수 있어요: 유선 부기, 젖 분비, 둥지 만들기, 행동 변화."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulig i diøstrus etterpå: hovent jur, melkeproduksjon, redebygging, endret atferd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogelijk in de dioestrus erna: gezwollen melkklieren, melkproductie, nestelen, veranderd gedrag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Possível durante o diestro seguinte: mamas inchadas, produção de leite, preparo de ninho, mudança de comportamento."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Möjligt under diöstrus efteråt: svullna juver, mjölkproduktion, bobyggande, ändrat beteende."
          }
        }
      }
    },
