    "Nur nötig, wenn eine Erinnerung fehlt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only needed if a reminder is missing."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen nodig als er een herinnering ontbreekt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessaire uniquement si un rappel manque."
          }
        },
        "es": {
