    "Befund und Kosten gehen mit verloren. Ein abgesagter Termin kann auch einfach im Verlauf bleiben.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fund og udgifter går også tabt. En aflyst tid kan også bare blive i historikken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Findings and costs will be lost too. A cancelled appointment can also just stay in the history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También se perderán el diagnóstico y los costes. Una cita cancelada también puede quedarse en el historial."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Myös löydökset ja kulut menetetään. Peruttu aika voi myös vain jäädä historiaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats et les frais seront aussi perdus. Un rendez-vous annulé peut aussi simplement rester dans l'historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anche referto e costi andranno persi. Un appuntamento annullato può anche restare semplicemente nella cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診察結果と費用も失われます。キャンセルした予約は履歴に残しておくこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진료 결과와 비용도 함께 삭제돼요. 취소된 예약은 기록에 그대로 남겨 둘 수도 있어요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Funn og kostnader går også tapt. En avlyst time kan også bare bli liggende i historikken."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevindingen en kosten gaan ook verloren. Een geannuleerde afspraak kan ook gewoon in de geschiedenis blijven staan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O diagnóstico e os custos também serão perdidos. Uma consulta cancelada também pode simplesmente ficar no histórico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fynd och kostnader försvinner också. Ett inställt besök kan också bara ligga kvar i historiken."
          }
        }
      }
    },
