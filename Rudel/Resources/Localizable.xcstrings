    "Fällig wird dann die Kotprobe, nicht die Gabe — entwurmt wird nur bei Befund.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Så er det afføringsprøven, der forfalder, ikke dosen — der gives kun ormekur ved fund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stool sample is then due instead of the dose — deworming only happens if something is found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces vence la muestra de heces, no la toma: solo se desparasita si el resultado es positivo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Silloin erääntyy ulostenäyte, ei annos — madotus tehdään vain löydöksen perusteella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est alors l'analyse de selles qui est prévue, pas la prise — le vermifuge n'est donné qu'en cas de résultat positif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo caso scade l'esame delle feci, non la somministrazione: si sverma solo con esito positivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その場合は投与ではなく検便が予定になり、虫下しは検査で見つかったときだけ行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 경우 투여 대신 분변 검사가 예정되며, 구충은 검사에서 발견될 때만 해요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Da er det avføringsprøven som forfaller, ikke dosen — ormekur gis bare ved funn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan is het ontlastingsonderzoek gepland, niet de toediening — ontwormd wordt alleen bij een positieve uitslag."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Então o exame de fezes fica previsto, não a dose — a vermifugação só acontece se o resultado for positivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då är det träckprovet som är dags, inte dosen — avmaskning sker bara vid positivt fynd."
          }
        }
      }
    },
    "Fällig wird die nächste Gabe aus der letzten Gabe plus Intervall.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Næste dosis beregnes ud fra sidste dosis plus intervallet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next dose is due at the last dose plus the interval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima toma vence en la última toma más el intervalo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuraava annos erääntyy, kun viimeisestä annoksesta on kulunut asetettu väli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine prise est prévue à la dernière prise plus l'intervalle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prossima somministrazione cade all'ultima più l'intervallo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回の投与は、前回の投与日に間隔を足した日です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 투여일은 마지막 투여일에 간격을 더해 정해져요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste dose beregnes fra siste dose pluss intervallet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De volgende toediening valt op de laatste toediening plus het interval."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima dose é prevista pela última dose mais o intervalo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
