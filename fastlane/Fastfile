default_platform(:ios)

# Single source: the app target's bundle ID in project.yml.
APP_IDENTIFIER = File.read("../project.yml")[/PRODUCT_BUNDLE_IDENTIFIER:\s*(\S+)/, 1]

platform :ios do
  private_lane :asc_api_key do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH")
    )
  end

  desc "Upload the exported IPA to TestFlight and hand it to the external group"
  lane :beta do
    # The external group only exists after a first upload; until TESTFLIGHT_GROUP is set, just upload.
    group = ENV.fetch("TESTFLIGHT_GROUP", "")
    distribute = !group.empty?
    options = {
      api_key: asc_api_key,
      ipa: ENV.fetch("IPA_PATH"),
      changelog: ENV.fetch("CHANGELOG"),
      distribute_external: distribute,
      groups: (distribute ? [group] : nil),
      skip_waiting_for_build_processing: !distribute
    }.compact
    pilot(options)
  end

  desc "Upload texts, review notes and (if present) fastlane/screenshots; no binary, no submission"
  lane :metadata do
    deliver(listing_options)
  end

  desc "Upload texts and screenshots, attach a TestFlight build and submit the version for review"
  desc "Pass build_number:N to pick a build; without it the latest processed build is used."
  desc "The approved version is not released automatically; release it by hand in App Store Connect."
  lane :submit do |options|
    deliver(listing_options.merge(
      build_number: options[:build_number],
      submit_for_review: true,
      automatic_release: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    ).compact)
  end
end

def listing_options
  screenshots = Dir.exist?("screenshots") && !Dir.glob("screenshots/*/*.png").empty?
  {
    api_key: asc_api_key,
    app_identifier: APP_IDENTIFIER,
    app_version: marketing_version,
    metadata_path: "./fastlane/metadata",
    screenshots_path: "./fastlane/screenshots",
    skip_binary_upload: true,
    skip_screenshots: !screenshots,
    overwrite_screenshots: true,
    app_review_information: review_information,
    force: true, # no HTML preview to confirm on a headless run
    precheck_include_in_app_purchases: false
  }.compact
end

# The contact for App Review comes from the environment so it stays out of the public repo.
def review_information
  notes = File.read("metadata/review_information/notes.txt").strip
  contact = {
    first_name: ENV["REVIEW_FIRST_NAME"],
    last_name: ENV["REVIEW_LAST_NAME"],
    email_address: ENV["REVIEW_EMAIL"],
    phone_number: ENV["REVIEW_PHONE"]
  }.reject { |_, value| value.to_s.empty? }
  contact.merge(notes: notes, demo_required: false)
end

def marketing_version
  File.read("../project.yml")[/MARKETING_VERSION:\s*"?([\d.]+)"?/, 1]
end
